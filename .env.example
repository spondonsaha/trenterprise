# ---------------------------------------------------------------------------
# TR Enterprise ERP - environment variables
# ---------------------------------------------------------------------------

# Neon pooled connection (the "-pooler" host). Used by the application.
# connection_limit=1 keeps serverless functions under Neon's connection cap.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx-pooler.region.aws.neon.tech/tr_enterprise?sslmode=require&pgbouncer=true&connection_limit=1&connect_timeout=15"

# Neon direct connection (no "-pooler"). Used by prisma migrate.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/tr_enterprise?sslmode=require"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Local development. On Vercel set this to the production URL.
NEXTAUTH_URL="http://localhost:3000"
